<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>TCC Mini — Hover + Set/Clear</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
  <style>
    :root{ --bg:#f6f7fb; --card:#fff; --text:#111827; --muted:#6b7280; --brand:#2563eb; --ring:#93c5fd; --line:#0f172a }
    *{ box-sizing:border-box }
    html,body{ margin:0; background:var(--bg); color:var(--text); font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif }
    .wrap{ max-width:960px; margin:24px auto; padding:0 16px; display:grid; gap:12px }
    .card{ background:var(--card); border-radius:14px; box-shadow:0 6px 24px rgba(0,0,0,.06); padding:14px }
    h1{ font-size:20px; margin:0 0 4px }
    p{ margin:0; color:var(--muted) }
    .row{ display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end }
    .field{ display:flex; flex-direction:column; gap:6px; min-width:220px; flex:0 0 auto }
    label{ font-size:12px; font-weight:600; color:#6b7280 }
    input{ padding:10px 12px; border:1px solid #e5e7eb; border-radius:10px; font-size:14px; outline:none }
    input:focus{ box-shadow:0 0 0 3px var(--ring); border-color:#bfdbfe }
    button{ background:var(--brand); color:#fff; border:0; padding:10px 14px; border-radius:10px; font-weight:600; cursor:pointer }
    button.ghost{ background:#eef2ff; color:#3730a3 }
    .chart{ height:520px; width:100% }
    .hint{ font-size:12px; color:var(--muted); margin-top:4px }
    /* Floating hover tooltip */
    .hover-tip{
      position:fixed; z-index:10; background:rgba(255,255,255,0.95);
      border:1px solid #e5e7eb; border-radius:8px; padding:6px 10px; font-size:13px;
      box-shadow:0 2px 10px rgba(0,0,0,.08); pointer-events:none; display:none; white-space:nowrap;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Time–Current Curve</h1>
      <p>Hover to probe; <strong>Set</strong> a current to pin; <strong>Clear</strong> to resume hover.</p>
      <div class="row" style="margin-top:10px">
        <div class="field">
          <label for="currentSet">Set current (A)</label>
          <input type="number" id="currentSet" placeholder="e.g., 4000" step="1" min="1" />
        </div>
        <div class="field" style="gap:8px">
          <button id="btnSet">Set</button>
          <button id="btnClear" class="ghost" type="button">Clear</button>
        </div>
        <div class="field" style="min-width:260px">
          <label for="smoothPoints">Smoothing (samples along curve)</label>
          <input id="smoothPoints" type="range" min="300" max="1500" step="100" value="900" />
          <div class="hint">Higher = smoother cursor movement.</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div id="chart" class="chart"></div>
    </div>
  </div>

  <div id="hoverTip" class="hover-tip"></div>

  <script>
  // ---------- Data (Current A, Time s) ----------
  const RAW = [
    [  760, 10000 ],
    [ 1000,  1000 ],
    [ 1800,   100 ],
    [ 2150,    30 ],
    [ 2750,    10 ],
    [ 3300,     4 ],
    [ 4200,     1 ],
    [ 4800,   0.4 ],
    [ 5500,   0.1 ],
    [ 6100,  0.04 ],
    [ 7800,  0.01 ],
    [ 9800, 0.004 ],
    [10600, 0.001 ],
    [20350,0.0004],
    [50000,0.0001],
  ];

  // ---------- Helpers ----------
  const PLOT_CONFIG = { responsive:true, displayModeBar:true, scrollZoom:false, doubleClick:'reset' };
  const CURSOR_TRACE_INDEX = 1; // [0]=line, [1]=cursor

  function pretty(v){
    if(v>=10000) return v.toFixed(0);
    if(v>=1000)  return v.toFixed(0);
    if(v>=100)   return v.toFixed(1);
    if(v>=10)    return v.toFixed(2);
    if(v>=1)     return v.toFixed(3);
    return v.toExponential(2);
  }
  function prettyTime(v){ return v>=1 ? v.toFixed(3) : v.toExponential(2); }

  function prepSeries(pairs){
    const valid = pairs.map(([x,y])=>[Number(x),Number(y)])
      .filter(([x,y])=>Number.isFinite(x)&&Number.isFinite(y)&&x>0&&y>0)
      .sort((a,b)=>a[0]-b[0]);
    return { X: valid.map(p=>p[0]), Y: valid.map(p=>p[1]) };
  }

  function interpolateLogLog(X, Y, samples){
    // Interpolate evenly in log10(x), linear in-between in log10 space
    const lx = X.map(Math.log10), ly = Y.map(Math.log10);
    const lxMin = lx[0], lxMax = lx[lx.length-1];
    const step = (lxMax - lxMin) / (samples - 1);
    const dX = [], dY = [];
    for(let k=0;k<samples;k++){
      const q = lxMin + step*k;
      // find lower bound index j-1 <= q <= j
      let lo=1, hi=lx.length-1, j=lx.length-1;
      while(lo<=hi){ const m=(lo+hi)>>1; if(lx[m]>=q){ j=m; hi=m-1; } else { lo=m+1; } }
      if(j<=0){ dX.push(10**lx[0]); dY.push(10**ly[0]); }
      else if(j>=lx.length){ dX.push(10**lx.at(-1)); dY.push(10**ly.at(-1)); }
      else {
        const t=(q-lx[j-1])/(lx[j]-lx[j-1]);
        dX.push(10**q);
        dY.push(10**(ly[j-1] + t*(ly[j]-ly[j-1])));
      }
    }
    return { dX, dY };
  }

  function nearestIndex(arr, x){
    let lo=0, hi=arr.length-1;
    if(!arr.length) return 0;
    if(x<=arr[0])   return 0;
    if(x>=arr[hi])  return hi;
    while(lo<=hi){
      const m=(lo+hi)>>1;
      if(arr[m]===x) return m;
      if(arr[m]<x) lo=m+1; else hi=m-1;
    }
    const i1=Math.max(0,lo-1), i2=Math.min(arr.length-1,lo);
    return Math.abs(arr[i1]-x)<=Math.abs(arr[i2]-x)?i1:i2;
  }

  function pixelToDataX(gd, px){
    const xax = gd._fullLayout.xaxis;
    const x0  = xax._offset;
    const w   = xax._length;
    const rx  = (px - x0) / w;
    if(rx<0 || rx>1) return null;
    // Convert pixel ratio to data (log)
    return Math.pow(10, xax.range[0] + rx*(xax.range[1]-xax.range[0]));
  }

  // ---------- Build chart ----------
  const series = prepSeries(RAW);
  let samples = Number(document.getElementById('smoothPoints').value);
  let dense   = interpolateLogLog(series.X, series.Y, samples);
  let forcedX = null; // when set via the input, disables hover

  const lineTrace = {
    x: dense.dX, y: dense.dY,
    type:'scatter', mode:'lines', name:'Curve',
    line:{ width:2, color:'#1f2937' },
    hoverinfo:'skip'
  };
  const cursorTrace = {
    x:[dense.dX[0]], y:[dense.dY[0]],
    type:'scatter', mode:'markers', name:'Cursor',
    marker:{ size:12, symbol:'circle', line:{width:2}, color:'orange' },
    hoverinfo:'skip'
  };
  const layout = {
    title:'TCC — Log-Log',
    dragmode:'pan',
    hovermode:false, // we manage our own hover
    xaxis:{ type:'log', title:'Current (A)', autorange:true, gridcolor:'#f1f5f9' },
    yaxis:{ type:'log', title:'Time (s)',    autorange:true, gridcolor:'#f1f5f9' },
    margin:{ l:60, r:10, t:40, b:52 },
    showlegend:false
  };

  Plotly.newPlot('chart', [lineTrace, cursorTrace], layout, PLOT_CONFIG).then(setupHover);

  function updateDenseAndRedraw(){
    samples = Number(document.getElementById('smoothPoints').value);
    dense   = interpolateLogLog(series.X, series.Y, samples);
    // keep autoscale; redraw line; keep cursor where it is (re-evaluate y at same x)
    const cx = forcedX ?? cursorTrace.x[0] ?? dense.dX[0];
    const cy = yAtX(cx);
    Plotly.react('chart',
      [
        { ...lineTrace, x:dense.dX, y:dense.dY },
        { ...cursorTrace, x:[cx], y:[cy] }
      ],
      layout,
      PLOT_CONFIG
    ).then(()=> {
      if(forcedX!=null) pinAnnotation(cx, cy);
    });
  }

  function yAtX(x){
    const idx = nearestIndex(dense.dX, x);
    return dense.dY[idx];
  }

  // ---------- Custom hover ----------
  const tip = document.getElementById('hoverTip');

  function setupHover(gd){
    const host = gd; let raf=null, lastEvt=null;

    host.addEventListener('mousemove', (e)=>{
      if(forcedX!=null) { tip.style.display='none'; return; } // disabled while pinned
      const r = host.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;

      // Boundaries of plotting area
      const xax = gd._fullLayout.xaxis, yax = gd._fullLayout.yaxis;
      const x0=xax._offset, xw=xax._length, y0=yax._offset, yh=yax._length;
      if(px<x0 || px>x0+xw || py<y0 || py>y0+yh){ tip.style.display='none'; return; }

      lastEvt = { clientX:e.clientX, clientY:e.clientY, px };
      if(raf) return;
      raf = requestAnimationFrame(()=>{
        const { clientX, clientY, px } = lastEvt;
        const x = pixelToDataX(gd, px);
        if(x==null) { tip.style.display='none'; raf=null; return; }

        const idx = nearestIndex(dense.dX, x);
        const cx  = dense.dX[idx];
        const cy  = dense.dY[idx];

        Plotly.restyle('chart', { x:[[cx]], y:[[cy]] }, [CURSOR_TRACE_INDEX]);

        tip.textContent = `Current: ${pretty(cx)} A  |  Time: ${prettyTime(cy)} s`;
        tip.style.left = (clientX + 14) + 'px';
        tip.style.top  = (clientY - 18) + 'px';
        tip.style.display = 'block';
        raf = null;
      });
    });

    host.addEventListener('mouseleave', ()=>{ tip.style.display='none'; });
  }

  // ---------- Pin / Unpin (Set / Clear) ----------
  function pinAnnotation(x, y){
    Plotly.relayout('chart', {
      annotations: [{
        x, y, xref:'x', yref:'y',
        text:`<b>${pretty(x)} A</b><br>${prettyTime(y)} s`,
        showarrow:true, arrowhead:2, ax:16, ay:-28,
        bgcolor:'#fff', bordercolor:'#e5e7eb', borderwidth:1, opacity:0.98
      }]
    });
  }
  function clearAnnotation(){
    Plotly.relayout('chart', { annotations: [] });
  }

  document.getElementById('btnSet').addEventListener('click', ()=>{
    const val = Number(document.getElementById('currentSet').value);
    if(!Number.isFinite(val) || val<=0) return;
    // clamp inside x-range
    const xmin = dense.dX[0], xmax = dense.dX[dense.dX.length-1];
    const cx = Math.min(Math.max(val, xmin), xmax);
    const cy = yAtX(cx);
    forcedX = cx;
    // place dot immediately and pin label
    Plotly.restyle('chart', { x:[[cx]], y:[[cy]] }, [CURSOR_TRACE_INDEX]).then(()=>{
      pinAnnotation(cx, cy);
      // hide floating hover tip (now frozen)
      tip.style.display='none';
    });
  });

  document.getElementById('btnClear').addEventListener('click', ()=>{
    forcedX = null;
    document.getElementById('currentSet').value = '';
    clearAnnotation();
    // move cursor to start so hover takes over naturally
    Plotly.restyle('chart', { x:[[dense.dX[0]]], y:[[dense.dY[0]]] }, [CURSOR_TRACE_INDEX]);
  });

  document.getElementById('smoothPoints').addEventListener('input', updateDenseAndRedraw);

  </script>
</body>
</html>
